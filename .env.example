PORT=5000

# ========================================================
# Supabase Database Configuration
# Obtain from: https://supabase.com -> Project Settings -> API
# ========================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ========================================================
# Primary / Single Admin Configuration
# ========================================================
ADMIN_EMAIL=rpodder2019@gmail.com
ADMIN_USERNAME=rup
ADMIN_PASSWORD=replace-with-a-strong-password

# Matching Vite Frontend aliases
VITE_ADMIN_EMAIL=rpodder2019@gmail.com
VITE_ADMIN_USERNAME=rup
VITE_ADMIN_PASSWORD=replace-with-a-strong-password

# ========================================================
# HOW TO ADD MULTIPLE ADMINS IN YOUR .env FILE:
# --------------------------------------------------------
# You have 3 easy options to add multiple administrators.
# Choose whichever format you prefer:
# ========================================================

# OPTION 1: Numbered Admin variables (Recommended - clean & readable)
# --------------------------------------------------------
# ADMIN_2_USERNAME=alex
# ADMIN_2_PASSWORD=replace-with-a-strong-password
# ADMIN_2_EMAIL=alex@quizpulse.com
# VITE_ADMIN_2_USERNAME=alex
# VITE_ADMIN_2_PASSWORD=replace-with-a-strong-password
# VITE_ADMIN_2_EMAIL=alex@quizpulse.com

# ADMIN_3_USERNAME=sarah
# ADMIN_3_PASSWORD=replace-with-a-strong-password
# ADMIN_3_EMAIL=sarah@quizpulse.com
# VITE_ADMIN_3_USERNAME=sarah
# VITE_ADMIN_3_PASSWORD=replace-with-a-strong-password
# VITE_ADMIN_3_EMAIL=sarah@quizpulse.com

# OPTION 2: Delimited List Format (username:password:email)
# --------------------------------------------------------
# ADMIN_ACCOUNTS="rup:replace-with-a-strong-password:rpodder2019@gmail.com, alex:replace-with-a-strong-password:alex@quizpulse.com, sarah:replace-with-a-strong-password:sarah@quizpulse.com"
# VITE_ADMIN_ACCOUNTS="rup:replace-with-a-strong-password:rpodder2019@gmail.com, alex:replace-with-a-strong-password:alex@quizpulse.com, sarah:replace-with-a-strong-password:sarah@quizpulse.com"

# OPTION 3: JSON Array Format
# --------------------------------------------------------
# ADMIN_USERS='[{"username":"rup","password":"replace-with-a-strong-password","email":"rpodder2019@gmail.com"},{"username":"alex","password":"replace-with-a-strong-password","email":"alex@quizpulse.com"}]'
# VITE_ADMIN_USERS='[{"username":"rup","password":"replace-with-a-strong-password","email":"rpodder2019@gmail.com"},{"username":"alex","password":"replace-with-a-strong-password","email":"alex@quizpulse.com"}]'
